<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description"
        android:textSize="12sp"
        android:alpha="0.6"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/et_finance_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Server Maintenance"
        android:inputType="textCapSentences"
        android:background="@android:color/transparent"
        android:paddingVertical="12dp"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount ($)"
        android:textSize="12sp"
        android:alpha="0.6"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/et_finance_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:background="@android:color/transparent"
        android:paddingVertical="12dp"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#1A000000" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:fontFamily="sans-serif-medium"
        android:text="Type"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rdo_finance_type"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rdo_income"
            android:layout_width="174dp"
            android:layout_height="wrap_content"
            android:text="Income" />

        <RadioButton
            android:id="@+id/rdo_expense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expense" />

    </RadioGroup>

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#1A000000" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:fontFamily="sans-serif-medium"
        android:text="Date of Transaction"
        android:textSize="12sp" />
    <LinearLayout
        android:id="@+id/dateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/textView3"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:alpha="0.6"
            android:fontFamily="sans-serif-medium"
            android:text="Month"
            android:gravity="center"
            android:textSize="16sp" />
        <NumberPicker
            android:id="@+id/spn_month"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textView4"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:alpha="0.6"
            android:fontFamily="sans-serif-medium"
            android:text="Day"
            android:gravity="center"
            android:textSize="16sp" />
        <NumberPicker
            android:id="@+id/spn_day"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textView5"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:alpha="0.6"
            android:fontFamily="sans-serif-medium"
            android:text="Year"
            android:gravity="center"
            android:textSize="16sp" />
        <NumberPicker
            android:id="@+id/spn_year"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    </LinearLayout>


</LinearLayout>